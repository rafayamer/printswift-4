{
  "name": "PrintSwift 4 Codespaces browser preview",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {"label": "PrintSwift 4 preview", "onAutoForward": "openPreview"}
  },
  "postStartCommand": "nohup python3 -m http.server 8000 --bind 0.0.0.0 >/tmp/printswift-preview.log 2>&1 &"
}
